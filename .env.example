# Development only; scripts/setup-dev.mjs generates a random local password.
POSTGRES_USER=myfit
POSTGRES_PASSWORD=replace-with-local-generated-password
POSTGRES_DB=myfit_dev
DATABASE_URL=postgresql://myfit:replace-with-local-generated-password@localhost:5432/myfit_dev
TEST_DATABASE_URL=postgresql://myfit:replace-with-local-generated-password@localhost:5433/myfit_test
INTERNAL_API_URL=http://localhost:4000
APP_URL=http://localhost:3000
