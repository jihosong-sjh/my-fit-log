{
  "name": "myfit-log",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "22.23.3",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @myfit/web dev",
    "dev:api": "pnpm --filter @myfit/api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:dev": "node scripts/setup-dev.mjs",
    "dev:up": "docker compose --env-file .env.development -f compose.dev.yml up -d --build --wait",
    "dev:down": "docker compose --env-file .env.development -f compose.dev.yml down",
    "test:dev": "node scripts/verify-dev.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.15",
    "prettier": "3.8.2",
    "typescript": "5.9.3"
  }
}
